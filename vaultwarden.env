# Vaultwarden configuration. The full list is in
# /usr/share/doc/vaultwarden/.env.template
# Settings changed in the admin page are stored in the data directory
# and override this file.

DATA_FOLDER=/var/lib/vaultwarden
WEB_VAULT_FOLDER=/usr/share/vaultwarden/web-vault

# Localhost only. Terminate TLS in a reverse proxy and set DOMAIN to
# the public https URL before exposing the service.
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=8000
DOMAIN=http://127.0.0.1:8000

# Refuses new accounts. Set this to true, create the first account,
# then set it back to false. With ADMIN_TOKEN set, the admin page can
# invite users while signups stay disabled.
SIGNUPS_ALLOWED=false

# Uncomment and set a long random value to enable /admin.
# Generate one with: vaultwarden hash
# ADMIN_TOKEN=

# SQLite is the default, stored under DATA_FOLDER.
# This build also supports MariaDB and PostgreSQL, for example:
# DATABASE_URL=postgresql://vaultwarden@127.0.0.1/vaultwarden
# DATABASE_URL=mysql://vaultwarden:password@127.0.0.1/vaultwarden
